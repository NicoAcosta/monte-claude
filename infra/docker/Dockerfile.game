FROM python:3.11-slim

WORKDIR /app

# System deps for psycopg binary
RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq5 && \
    rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
RUN pip install --no-cache-dir uv

# Copy server package
COPY packages/server/pyproject.toml packages/server/uv.lock ./
RUN uv pip install --system -e . || true

COPY packages/server/src/ ./src/

# Re-install now that source is present (editable install needs src/)
RUN uv pip install --system -e .

EXPOSE 8001

# Single worker — game state lives in-memory, single authority
CMD ["uvicorn", "game_api.app:app", "--host", "0.0.0.0", "--port", "8001"]
